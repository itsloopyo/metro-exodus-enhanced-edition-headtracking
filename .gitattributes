* text=auto eol=lf

# Windows batch/cmd scripts require CRLF or they silently fail
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# The committed settings file is byte-exact: the render test compares it with the
# config table, and the launcher seed is its bytes.
MetroExodusHeadTracking.ini -text

# Binary files (do not normalize)
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.dll binary
*.asi binary
*.exe binary
*.pdb binary
*.lib binary

# Differential test inputs are byte-exact player files: CRLF, and whatever else a build wrote.
tests/config_differential/inputs/** -text
