# Build outputs
build/
build-tests/
bin/
obj/
out/
dist/
release/
x64/
Debug/
Release/
*.user
*.suo
*.vcxproj.user

# Build binaries (the vendored loader below is the exception)
*.dll
*.asi
*.exe
*.pdb
*.lib
*.exp
*.ilk

# Vendored third-party binaries (overrides the extension rules above)
!vendor/**/*.dll
!vendor/**/*.exe

# CMake artifacts at root
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile

# Game DLLs (referenced at build time, never committed)
libs/*.dll
src/*/libs/*.dll

# Pixi / IDE
.pixi/
.vs/
.vscode/
.idea/

# Local notes / doctrine files (per AGENTS.md)
.claude/
