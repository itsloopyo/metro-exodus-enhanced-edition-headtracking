.aider*

# Skills, agents, MCP server configs (local/per-user only)
.skills/
skills/
.agents/
agents/
.mcp.json
mcp.json
*.mcp.json
.mcp/
mcp-servers/

# Reverse-engineering working output (kept on disk, never deliverable)
